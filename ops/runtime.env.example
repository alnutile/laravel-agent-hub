APP_NAME="Agent Hub"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/hub.sqlite
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
AGENT_DRIVER=demo
GROKKED_URL=
GROKKED_TOKEN=
GROKKED_BOT_ID=
AGENT_ALLOWED_DOMAINS=example.com
AGENT_MAX_USD=2
AGENT_MAX_STEPS=30
